{
  "name": "react-semantic-images",
  "version": "0.2.2",
  "description": "Drop <SemanticImage description=\"...\"> into your React app. Run two commands. Get the best-matching image from your pool assigned to every slot — locally, no API keys.",
  "keywords": [
    "react",
    "nextjs",
    "vite",
    "images",
    "semantic",
    "clip",
    "ai",
    "embeddings",
    "image-matching"
  ],
  "homepage": "https://github.com/jachymri/react-semantic-images",
  "bugs": {
    "url": "https://github.com/jachymri/react-semantic-images/issues"
  },
  "author": "Jachym Richtrmoc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jachymri/react-semantic-images.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "collect-descriptions": "dist/cli/collect.js",
    "match-images": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js dist/cli/collect.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "fast-glob": "^3.3.2"
  },
  "optionalDependencies": {
    "playwright": "^1.40.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "^5.4.0"
  }
}
